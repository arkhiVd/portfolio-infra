---
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { site, url } from "../lib/site";
import { getFeaturedProjects } from "../lib/projects";
import { getHomePage, getPublishedReferences } from "../lib/content";
const [home, featured, references] = await Promise.all([
  getHomePage(),
  getFeaturedProjects(),
  getPublishedReferences(),
]);
const hasHomelab = references.some((entry) => entry.id === "homelab");
---

<Base title={`${site.name} — ${site.role}`} current="home">
  <section class="hero wrap">
    <h1>{site.name}</h1>
    <p class="hero-lead"><strong>{home.hero.role.replace(/[.!?]+$/, "")}.</strong> {home.hero.introduction}</p>
    <div class="cta">
      <a class="btn" href={url("/projects")}>View projects</a>
      <a class="btn-outline" href={url(site.resume)}>Download resume</a>
      <a class="btn-quiet" href={`mailto:${site.email}`}>email me →</a>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>Selected work</h2>
      <a class="label" href={url("/projects")}>all projects →</a>
    </div>
    <div class="project-list">
      {featured.map((project) => <ProjectRow project={project} compact />)}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>More from the work</h2>
    </div>
    <div class="discover-list">
      <a href={url("/blog")}>
        <span><strong>{home.discover.blog.title}</strong><small>{home.discover.blog.description}</small></span>
        <span class="project-arrow" aria-hidden="true">→</span>
      </a>
      {hasHomelab && <a href={url("/homelab")}>
        <span><strong>{home.discover.homelab.title}</strong><small>{home.discover.homelab.description}</small></span>
        <span class="project-arrow" aria-hidden="true">→</span>
      </a>}
      {references.some((entry) => entry.id === "how-i-work") && <a href={url("/how-i-work")}>
        <span><strong>{home.discover.workflow.title}</strong><small>{home.discover.workflow.description}</small></span>
        <span class="project-arrow" aria-hidden="true">→</span>
      </a>}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>About</h2>
      <a class="label" href={url("/about")}>more →</a>
    </div>
    <p class="prose">{home.about}</p>
  </section>
</Base>
