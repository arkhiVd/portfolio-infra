---
import Base from "../layouts/Base.astro";
import CaseCard from "../components/CaseCard.astro";
import { site, url } from "../lib/site";
import { featured, projects } from "../lib/projects";
---

<Base title={`${site.name} — ${site.role}`} current="home">
  <section class="hero wrap">
    <h1>I build and run cloud infrastructure.</h1>
    <p>
      Cloud engineer at Centilytics, working across AWS, Terraform, containers and CI/CD —
      and the Linux underneath all of it. AWS Solutions Architect – Associate and CCNA
      certified, CKA in progress.
    </p>
    <div class="cta">
      <a class="btn" href={url("/projects")}>View projects</a>
      <a class="btn-quiet" href={`mailto:${site.email}`}>get in touch →</a>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>Selected work</h2>
      <a class="label" href={url("/projects")}>
        {featured.length} of {projects.length} · all projects →
      </a>
    </div>
    <div class="cards">
      {featured.map((project) => <CaseCard project={project} />)}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>About</h2>
      <a class="label" href={url("/about")}>more →</a>
    </div>
    <p class="prose">
      Cloud engineer at Centilytics since October 2025, working on cloud management and
      infrastructure automation. ECE graduate, AWS Solutions Architect – Associate and CCNA
      certified, currently working through the CKA. Everything above runs in my own AWS
      account, built with Terraform and shipped by keyless OIDC pipelines.
    </p>
  </section>
</Base>
