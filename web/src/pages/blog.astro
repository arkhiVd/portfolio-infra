---
import Base from "../layouts/Base.astro";
import { getPublishedBlogPosts } from "../lib/content";
import { site, url } from "../lib/site";

const posts = await getPublishedBlogPosts();
---

<Base title={`Blog — ${site.name}`} description="Writing by Aravindakrishnan V." current="blog">
  <section class="blog-index wrap">
    <p class="label">blog</p>
    <h1>Blog</h1>
    <p class="lede">Whatever I am building, fixing or thinking about.</p>
    <p><a class="label" href={url("/feed.xml")}>RSS feed</a></p>
    <div class="project-list" aria-label="Blog posts">
      {posts.map((post) => (
        <a class="blog-row" href={url(`/blog/${post.id}`)}>
          <time datetime={post.data.published}>{post.data.published}</time>
          <span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </span>
          <span class="project-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
</Base>
