---
import { getEntry } from "astro:content";
import CaseStudy from "../../layouts/CaseStudy.astro";
import { renderCaseStudyBody } from "../../lib/case-study";
import { getProject } from "../../lib/projects";

const project = await getProject("portfolio");
const entry = await getEntry("project", "portfolio");
const body = renderCaseStudyBody(entry!.body, project);
---

<CaseStudy project={project} kicker={project.kicker!} lede={project.lede!}>
  <Fragment set:html={body} />
</CaseStudy>
