---
import { render } from "astro:content";
import Reference from "../layouts/Reference.astro";
import HomelabAtlas from "../components/HomelabAtlas.astro";
import HowIWorkPage from "../components/how-work/HowIWorkPage.astro";
import Base from "../layouts/Base.astro";
import { getPublishedReferences } from "../lib/content";

export async function getStaticPaths() {
  const references = await getPublishedReferences();
  return references.map((entry) => ({ params: { reference: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
{entry.id === "homelab" ? (
  <Base title="Homelab Atlas — Aravindakrishnan V" description="A public architecture atlas of a self-hosted homelab." current="homelab">
    <HomelabAtlas />
  </Base>
) : entry.id === "how-i-work" ? (
  <HowIWorkPage entry={entry} />
) : (
  <Reference id={entry.id} {...entry.data}><Content /></Reference>
)}
