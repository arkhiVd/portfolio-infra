<div class="ocean" aria-hidden="true">
  <canvas></canvas>
  <span class="ocean-noise"></span>
  <span class="ocean-fade"></span>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".ocean canvas");
  const gl = canvas?.getContext("webgl", { antialias: false, depth: false, stencil: false });

  if (canvas && gl) {
    const vertex = `attribute vec2 p; void main(){ gl_Position = vec4(p,0.,1.); }`;
    const fragment = `
precision highp float;
uniform vec2 res; uniform float t1; uniform float t2;
float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453123); }
float vnoise(vec2 p){
  vec2 i=floor(p), f=fract(p); vec2 u=f*f*(3.-2.*f);
  return mix(mix(hash(i),hash(i+vec2(1.,0.)),u.x), mix(hash(i+vec2(0.,1.)),hash(i+vec2(1.,1.)),u.x), u.y);
}
float fbm(vec2 p){ return vnoise(p)*0.55 + vnoise(p*2.3+7.7)*0.3 + vnoise(p*4.9+3.1)*0.15; }
void main(){
  vec2 uv = gl_FragCoord.xy / res;
  float asp = res.x / res.y;
  float amp = 26.0 / res.y;
  float breathe1 = 0.78 + 0.22 * sin(t1*1.7 + 1.2);
  float breathe2 = 0.78 + 0.22 * sin(t1*1.3 + 4.0);
  float swell = fbm(uv*1.4 + vec2(t1*0.25, -t1*0.18));
  swell = smoothstep(0.35, 0.75, swell) * 0.18;
  vec2 warp = vec2(
    fbm(uv*3.0 + vec2(t1*0.15, t1*0.11)) - 0.5,
    fbm(uv*3.0 + vec2(9.4 - t1*0.13, 5.2 + t1*0.17)) - 0.5
  ) * amp * 2.0 + vec2(
    fbm(uv*7.0 + vec2(t2*0.5, 3.3 - t2*0.4)) - 0.5,
    fbm(uv*7.0 + vec2(6.1 + t2*0.45, t2*0.55)) - 0.5
  ) * amp * 0.8;
  vec2 q = uv + warp;
  vec2 pq = vec2(q.x*asp, q.y);
  vec2 c1 = vec2(-0.15*asp + 0.09*sin(t1*0.9), 1.25 + 0.07*cos(t1*0.7));
  vec2 d1 = pq - c1;
  float size1 = 0.85 * (1.0 + 0.28 * sin(t1*1.1 + 0.6));
  float dd = length(vec2(dot(d1, normalize(vec2(1.0,-0.45)))*0.55, dot(d1, normalize(vec2(0.45,1.0)))*1.4));
  float g1 = pow(clamp(1.0 - dd*size1, 0.0, 1.0), 2.2);
  vec2 d2 = pq - vec2(1.15*asp + 0.06*cos(t1*0.6 + 2.0), 1.05 + 0.05*sin(t1*0.75));
  float size2 = 0.95 * (1.0 + 0.22 * sin(t1*0.8 + 3.5));
  float g2 = pow(clamp(1.0 - length(d2)*size2, 0.0, 1.0), 2.4);
  vec3 base = vec3(0.0196, 0.0196, 0.0275);
  vec3 cyan = vec3(0.24, 0.66, 0.74);
  vec3 blue = vec3(0.26, 0.36, 0.72);
  float core1 = pow(clamp(1.0 - dd*size1, 0.0, 1.0), 6.0);
  float core2 = pow(clamp(1.0 - length(d2)*size2, 0.0, 1.0), 6.5);
  vec3 col = base + cyan*g1*(0.46*breathe1 + swell*1.4) + cyan*core1*0.34*breathe1 + blue*g2*0.24*breathe2 + blue*core2*0.16*breathe2;
  col = mix(col, base, smoothstep(0.42, 0.02, uv.y));
  col += (hash(gl_FragCoord.xy) - 0.5) / 255.0 * 1.5;
  gl_FragColor = vec4(col, 1.0);
}`;
    const shader = (type: number, source: string) => {
      const value = gl.createShader(type)!;
      gl.shaderSource(value, source);
      gl.compileShader(value);
      return value;
    };
    const program = gl.createProgram()!;
    gl.attachShader(program, shader(gl.VERTEX_SHADER, vertex));
    gl.attachShader(program, shader(gl.FRAGMENT_SHADER, fragment));
    gl.linkProgram(program);
    gl.useProgram(program);
    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
    const location = gl.getAttribLocation(program, "p");
    gl.enableVertexAttribArray(location);
    gl.vertexAttribPointer(location, 2, gl.FLOAT, false, 0, 0);
    const resolution = gl.getUniformLocation(program, "res");
    const timeOne = gl.getUniformLocation(program, "t1");
    const timeTwo = gl.getUniformLocation(program, "t2");
    const resize = () => {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(resolution, canvas.width, canvas.height);
    };
    resize();
    window.addEventListener("resize", resize);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let frame = 0;
    const draw = (now: number) => {
      const seconds = now / 1000;
      gl.uniform1f(timeOne, seconds * (Math.PI * 2 / 40));
      gl.uniform1f(timeTwo, seconds * (Math.PI * 2 / 12));
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!reduced) frame = requestAnimationFrame(draw);
    };
    if (reduced) draw(10000);
    else frame = requestAnimationFrame(draw);
    window.addEventListener("pagehide", () => {
      cancelAnimationFrame(frame);
      window.removeEventListener("resize", resize);
    }, { once: true });
  }
</script>
