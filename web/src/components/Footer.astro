---
import { site } from "../lib/site";
import VisitorCount from "./VisitorCount.astro";
---

<footer class="foot">
  <div class="wrap">
    <div class="footer-panel">
      <div class="footer-col">
        <span class="label">work</span>
        <p>Cloud · DevOps · Infrastructure</p>
      </div>
      <div class="footer-col">
        <span class="label">mail</span>
        <a href={`mailto:${site.email}`}>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <rect x="1" y="3" width="14" height="10" rx="1.5" fill="none" stroke="currentColor" />
            <path d="m1.5 4 6.5 5 6.5-5" fill="none" stroke="currentColor" />
          </svg>
          {site.email}
        </a>
      </div>
      <div class="footer-col">
        <span class="label">connect</span>
        <div class="footer-links">
          <a href={site.github} rel="me noopener">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.49c-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.6 7.6 0 0 1 8 3.36c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z" />
            </svg>
            GitHub
          </a>
          <a href={site.linkedin} rel="me noopener">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path fill="currentColor" d="M2.9 1.5a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8ZM1.7 5.4h2.5v9.1H1.7V5.4Zm4.3 0h2.4v1.24h.03c.33-.63 1.15-1.3 2.37-1.3 2.53 0 3 1.67 3 3.84v5.32h-2.5V9.78c0-1.13-.02-2.58-1.57-2.58-1.57 0-1.81 1.23-1.81 2.5v4.8H6V5.4Z" />
            </svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
    <div class="footer-meta">
      <span>© 2026 {site.name}</span>
      <VisitorCount />
    </div>
  </div>
</footer>
