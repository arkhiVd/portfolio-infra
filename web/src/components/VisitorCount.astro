---
/**
 * Visitor counter. `window.VISITOR_API` is set by /assets/js/visitorscript.js, which
 * Terraform renders with the Lambda Function URL so it is never hand-copied.
 *
 * Real backend only. If the API is missing, slow or failing, the readout keeps its ····
 * placeholder — a fabricated number is worse than no number (DESIGN.md § Visitor counter).
 * Progressive enhancement: with JavaScript off the placeholder is what ships, and nothing
 * else on the page depends on this running.
 */
---

<span class="status"><span id="visitor-count">····</span> visitors</span>

<script is:inline>
  (function () {
    var el = document.getElementById("visitor-count");
    if (!el) return;

    function start() {
      var api = window.VISITOR_API;
      if (!api) return; // placeholder stays

      var ctl = new AbortController();
      var timer = setTimeout(function () {
        ctl.abort();
      }, 5000);

      fetch(api, { method: "POST", signal: ctl.signal })
        .then(function (r) {
          if (!r.ok) throw new Error("HTTP " + r.status);
          return r.json();
        })
        .then(function (d) {
          // Only render a real, finite count. Anything else leaves the placeholder.
          if (typeof d.count === "number" && isFinite(d.count)) {
            el.textContent = String(d.count);
          }
        })
        .catch(function () {
          /* placeholder stays */
        })
        .finally(function () {
          clearTimeout(timer);
        });
    }

    // visitorscript.js is loaded with defer, so it may not have run yet.
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
</script>
