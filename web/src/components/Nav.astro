---
import { site, url } from "../lib/site";
import { getPublishedReferences } from "../lib/content";
const references = await getPublishedReferences();

interface Props {
  current?: "home" | "projects" | "about" | "blog" | "homelab" | "how-i-work";
}
const { current } = Astro.props;

const links: { id: NonNullable<Props["current"]>; label: string; href: string }[] = [
  { id: "home", label: "home", href: url("/") },
  { id: "projects", label: "projects", href: url("/projects") },
  { id: "about", label: "about", href: url("/about") },
  { id: "blog", label: "blog", href: url("/blog") },
  ...(references.some((entry) => entry.id === "homelab")
    ? [{ id: "homelab" as const, label: "homelab", href: url("/homelab") }]
    : []),
  ...(references.some((entry) => entry.id === "how-i-work")
    ? [{ id: "how-i-work" as const, label: "how i work", href: url("/how-i-work") }]
    : []),
];
---

<header class="nav">
  <div class="wrap">
    <a class="brand" href={url("/")} aria-label={`${site.name} — home`}>
      <svg viewBox="0 0 64 40" aria-hidden="true">
        <path d="M16 33h32a10 10 0 0 0 1-20 15 15 0 0 0-28-3A12 12 0 0 0 16 33Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      </svg>
    </a>
    <div class="nav-actions">
      {
        site.openToWork && (
          <span class="status">
            <span class="dot" aria-hidden="true" />
            {site.availability}
          </span>
        )
      }
      <nav class="nav-links" aria-label="Primary">
        {links.map((link) => <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>)}
      </nav>
      {/* Phones get one row and a disclosure sheet. <details> opens without JavaScript. */}
      <details class="nav-menu">
        <summary><span class="nav-menu-closed">menu</span><span class="nav-menu-open">close</span></summary>
        <nav class="nav-sheet" aria-label="Primary">
          {links.map((link) => <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
