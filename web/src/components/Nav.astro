---
import { site, url } from "../lib/site";
import { getPublishedReferences } from "../lib/content";
const references = await getPublishedReferences();

interface Props {
  current?: "home" | "projects" | "about" | "blog" | "homelab" | "how-i-work";
}
const { current } = Astro.props;
---

<header class="nav">
  <div class="wrap">
    <a class="brand" href={url("/")} aria-label={`${site.name} — home`}>
      <svg viewBox="0 0 64 40" aria-hidden="true">
        <path d="M16 33h32a10 10 0 0 0 1-20 15 15 0 0 0-28-3A12 12 0 0 0 16 33Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      </svg>
    </a>
    <div class="nav-actions">
      {
        site.openToWork && (
          <span class="status">
            <span class="dot" aria-hidden="true" />
            {site.availability}
          </span>
        )
      }
      <nav class="nav-links" aria-label="Primary">
        <a href={url("/")} aria-current={current === "home" ? "page" : undefined}>home</a>
        <a href={url("/projects")} aria-current={current === "projects" ? "page" : undefined}>projects</a>
        <a href={url("/about")} aria-current={current === "about" ? "page" : undefined}>about</a>
        <a href={url("/blog")} aria-current={current === "blog" ? "page" : undefined}>blog</a>
        {references.some((entry) => entry.id === "homelab") && <a href={url("/homelab")} aria-current={current === "homelab" ? "page" : undefined}>homelab</a>}
        {references.some((entry) => entry.id === "how-i-work") && <a href={url("/how-i-work")} aria-current={current === "how-i-work" ? "page" : undefined}>how i work</a>}
      </nav>
    </div>
  </div>
</header>
