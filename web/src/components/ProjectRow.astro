---
import type { Project } from "../lib/projects";
import { url } from "../lib/site";

interface Props { project: Project; compact?: boolean; }
const { project, compact = false } = Astro.props;
const href = project.caseStudy ? url(project.caseStudy) : project.repo;
const Tag = href ? "a" : "article";
---

<Tag class:list={["project-row", { compact }]} href={href} {...(href && !project.caseStudy ? { rel: "noopener" } : {})}>
  <div class="project-row-main">
    <div class="project-row-title">
      <h2>{project.name}</h2>
      {!compact && <span class="label">{project.status}</span>}
    </div>
    {!compact && <p>{project.summary}</p>}
    {!compact && <span class="project-stack">{project.stack.join(" · ")}</span>}
  </div>
  {href && <span class="project-arrow" aria-hidden="true">→</span>}
</Tag>
