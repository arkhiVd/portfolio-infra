---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  published: string;
  updated?: string;
}
const { title, description, published, updated } = Astro.props;
---

<Base
  title={`${title} — Aravindakrishnan V`}
  description={description}
  current="blog"
  article={{ published, updated }}
>
  <article class="reading wrap">
    <p class="label">blog</p>
    <h1>{title}</h1>
    <time datetime={published}>Published {published}</time>
    {updated && <time datetime={updated}>Updated {updated}</time>}
    <p class="reading-summary">{description}</p>
    <slot />
  </article>
</Base>
