---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { caseStudyMetrics, caseStudySections } from "../lib/case-study";
import { getProjects, type Project } from "../lib/projects";
import { url } from "../lib/site";

/**
 * Case-study shell. Section order is fixed by DESIGN.md:
 * problem → architecture → decisions and tradeoffs → what broke → numbers.
 * "What broke" is not optional; a case study without a failure is a brochure.
 */
interface Props {
  project: Project;
  /** short kicker above the title, e.g. "serverless · 2026" */
  kicker: string;
  lede: string;
}
const { project, kicker, lede } = Astro.props;

// The numbers and section labels come from the same validated Markdown body the page renders.
const source = (await getEntry("project", project.slug))?.body ?? "";
const metrics = caseStudyMetrics(source).slice(0, 4);
const sections = caseStudySections(source);
const studies = (await getProjects()).filter((entry) => entry.caseStudy);
const index = studies.findIndex((entry) => entry.slug === project.slug);
const previous = index > 0 ? studies[index - 1] : undefined;
const next = index >= 0 && index < studies.length - 1 ? studies[index + 1] : undefined;
const shortName = (entry: Project) => entry.name.split(" — ")[0];
---

<Base title={`${project.name} — case study`} description={lede} current="projects">
  <section class="study wrap">
    <p class="label">case study · {kicker}</p>
    <h1>{project.name}</h1>
    <p class="lede">{lede}</p>
    {
      project.repo && (
        <div class="cta">
          <a class="btn-quiet" href={project.repo} rel="noopener">
            read the source ↗
          </a>
          {project.secondaryRepo && (
            <a class="btn-quiet" href={project.secondaryRepo.url} rel="noopener">
              {project.secondaryRepo.label} ↗
            </a>
          )}
        </div>
      )
    }
    {
      metrics.length > 0 && (
        <ul class="glance" aria-label="Key numbers">
          {metrics.map((metric) => (
            <li>
              <b>{metric.value}</b>
              <span>{metric.label}</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <div class="study-body wrap">
    <div class="study-main"><slot /></div>
    <nav class="study-contents" aria-label="On this page">
      <span class="label">on this page</span>
      {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
    </nav>
  </div>

  {
    (previous || next) && (
      <nav class="study-pager wrap" aria-label="More case studies">
        {previous ? (
          <a class="study-pager-prev" href={url(previous.caseStudy!)}>
            <span class="label">← previous</span>
            <span>{shortName(previous)}</span>
          </a>
        ) : <span />}
        {next && (
          <a class="study-pager-next" href={url(next.caseStudy!)}>
            <span class="label">next →</span>
            <span>{shortName(next)}</span>
          </a>
        )}
      </nav>
    )
  }
</Base>
